# Copy this file to .env and adjust as needed.

# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/booking_management

# Or a MongoDB Atlas connection string:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/booking_management

PORT=5000

# Used once, the first time the server starts, to create the initial admin
# account (only if no Admin document exists yet). Change the password after
# your first login if this ever runs somewhere other than your own machine.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Secret used to sign admin login sessions (JWTs). Use a long random string
# in any real deployment — this default is only for local development.
JWT_SECRET=dev-secret-change-me

